# Copy this file to .env and replace every placeholder locally.
# Never commit the real .env file.

ConnectionStrings__DefaultConnection=Server=localhost;Database=VehicleCenterDB;Trusted_Connection=True;TrustServerCertificate=True;

Jwt__Key=replace-with-a-random-secret-of-at-least-32-characters
Jwt__Issuer=VehicleServiceCenterApi
Jwt__Audience=VehicleServiceCenterFrontend
Jwt__ExpireMinutes=60

EmailSettings__SmtpServer=smtp.example.com
EmailSettings__SmtpPort=587
EmailSettings__SenderEmail=no-reply@example.com
EmailSettings__SenderPassword=replace-with-an-app-password
EmailSettings__SenderName=Vehicle Service Center
